@model UsuariosListaViewModel
@{
    ViewData["Title"] = "Usuarios";
    var urlActual = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuarios <small class="text-muted fs-6">(@Model.Total)</small></h1>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success" role="status">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="q" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre o correo" aria-label="Buscar por nombre o correo" />
    </div>
    <div class="col-md-3">
        <select name="rol" class="form-select" aria-label="Rol">
            <option value="">Todos los roles</option>
            <option value="Cliente" selected="@(Model.Rol == RolUsuario.Cliente)">Cliente</option>
            <option value="Admin" selected="@(Model.Rol == RolUsuario.Admin)">Admin</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="activo" class="form-select" aria-label="Estado">
            <option value="">Todos</option>
            <option value="true" selected="@(Model.Activo == true)">Activos</option>
            <option value="false" selected="@(Model.Activo == false)">Inactivos</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-dark">Filtrar</button>
    </div>
</form>

<div class="table-responsive bg-white border">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Registro</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td>@u.NombreCompleto @if (u.EsUsuarioActual) { <small class="text-muted">(tú)</small> }</td>
                <td>@u.Correo</td>
                <td>@u.Telefono</td>
                <td><span class="badge @(u.Rol == RolUsuario.Admin ? "text-bg-dark" : "text-bg-secondary")">@u.Rol</span></td>
                <td>
                    @if (u.Activo)
                    {
                        <span class="badge text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">Inactivo</span>
                    }
                    @if (u.EstaBloqueado)
                    {
                        <span class="badge text-bg-warning">Bloqueado</span>
                    }
                </td>
                <td>@u.FechaRegistro</td>
                <td class="text-end text-nowrap">
                    @if (u.EstaBloqueado)
                    {
                        <form asp-action="Desbloquear" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="returnUrl" value="@urlActual" />
                            <button type="submit" class="btn btn-sm btn-outline-warning">Desbloquear</button>
                        </form>
                    }
                    @if (!u.EsUsuarioActual)
                    {
                        <form asp-action="CambiarEstado" method="post" class="d-inline"
                              data-confirmar="@(u.Activo ? "¿Desactivar a este usuario? Su sesión se cerrará." : "¿Activar a este usuario?")">
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="activo" value="@((!u.Activo).ToString().ToLowerInvariant())" />
                            <input type="hidden" name="returnUrl" value="@urlActual" />
                            <button type="submit" class="btn btn-sm @(u.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(u.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted py-4">No hay usuarios con esos filtros.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPaginas > 1)
{
    <nav class="mt-3" aria-label="Páginas">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPaginas; p++)
            {
                <li class="page-item @(p == Model.Pagina ? "active" : null)">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@p" asp-route-q="@Model.Busqueda"
                       asp-route-rol="@Model.Rol" asp-route-activo="@Model.Activo">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/js/panel.js" asp-append-version="true"></script>
}
