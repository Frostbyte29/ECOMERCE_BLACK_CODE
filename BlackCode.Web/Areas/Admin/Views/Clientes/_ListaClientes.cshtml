@using BlackCode.Web.ViewModels
@model ClientesListaViewModel
@{
    string UrlOrden(string columna)
    {
        var dirActual = string.Equals(Model.Orden, columna, StringComparison.OrdinalIgnoreCase) ? Model.Dir : null;
        var nuevaDir  = string.Equals(dirActual, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
        return Url.Action("Index", new { q = Model.Busqueda, activo = Model.Activo, orden = columna, dir = nuevaDir, pagina = 1 })!;
    }

    string ClaseOrden(string columna)
    {
        if (!string.Equals(Model.Orden, columna, StringComparison.OrdinalIgnoreCase)) return "ordenable";
        return string.Equals(Model.Dir, "desc", StringComparison.OrdinalIgnoreCase)
            ? "ordenable ordenable--desc" : "ordenable ordenable--asc";
    }

    var desde = Model.Total > 0 ? (Model.Pagina - 1) * Model.TamanoPagina + 1 : 0;
    var hasta = Math.Min(Model.Pagina * Model.TamanoPagina, Model.Total);
}

<div class="tarjeta-panel">

    <div class="banda-panel">
        <div>
            <h1 class="banda-panel__titulo">Clientes</h1>
            <p class="banda-panel__subtitulo">Gestión de cartera de clientes</p>
        </div>
        <div class="banda-panel__acciones">
            <div class="banda-panel__contadores">
                <div class="contador-chip">
                    <span class="contador-chip__numero">@Model.TotalClientes</span>
                    <span class="contador-chip__etiqueta">Total</span>
                </div>
                <div class="contador-chip">
                    <span class="contador-chip__numero">@Model.Activos</span>
                    <span class="contador-chip__etiqueta">Activos</span>
                </div>
                <div class="contador-chip">
                    <span class="contador-chip__numero">@Model.Inactivos</span>
                    <span class="contador-chip__etiqueta">Inactivos</span>
                </div>
            </div>
            <a asp-action="Nuevo" class="btn btn-light btn-sm">+ Nuevo cliente</a>
        </div>
    </div>

    <div class="tarjeta-panel__cuerpo">

        <div class="d-flex align-items-end gap-3 mb-0">
            <form method="get" asp-action="Index" class="buscador-panel flex-grow-1" style="max-width:380px">
                <input type="hidden" name="activo" value="@(Model.Activo.HasValue ? Model.Activo.Value.ToString().ToLower() : "")" />
                <input type="hidden" name="orden" value="@Model.Orden" />
                <input type="hidden" name="dir" value="@Model.Dir" />
                <span class="buscador-panel__icono" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </span>
                <input name="q" value="@Model.Busqueda" class="form-control form-control-sm"
                       placeholder="Buscar por nombre o correo" aria-label="Buscar" />
            </form>
        </div>

        <div class="pestanas-filtro mt-3">
            <a href="@Url.Action("Index", new { q = Model.Busqueda, orden = Model.Orden, dir = Model.Dir, pagina = 1 })"
               class="pestana-filtro @(Model.Activo == null ? "pestana-filtro--activa" : null)">Todos</a>
            <a href="@Url.Action("Index", new { q = Model.Busqueda, activo = "true", orden = Model.Orden, dir = Model.Dir, pagina = 1 })"
               class="pestana-filtro @(Model.Activo == true ? "pestana-filtro--activa" : null)">Activos</a>
            <a href="@Url.Action("Index", new { q = Model.Busqueda, activo = "false", orden = Model.Orden, dir = Model.Dir, pagina = 1 })"
               class="pestana-filtro @(Model.Activo == false ? "pestana-filtro--activa" : null)">Inactivos</a>
        </div>

        <div class="table-responsive">
            <table class="table table-clientes table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="col-avatar"></th>
                        <th><a href="@UrlOrden("nombre")" class="@ClaseOrden("nombre")">Nombre</a></th>
                        <th class="d-none d-md-table-cell col-correo">Correo</th>
                        <th class="d-none d-md-table-cell col-telefono">Teléfono</th>
                        <th class="col-estado"><a href="@UrlOrden("estado")" class="@ClaseOrden("estado")">Estado</a></th>
                        <th class="d-none d-md-table-cell col-acceso"><a href="@UrlOrden("acceso")" class="@ClaseOrden("acceso")">Último acceso</a></th>
                        <th class="col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Items)
                {
                    var inicial = string.IsNullOrEmpty(c.NombreCompleto) ? "?" : c.NombreCompleto[0].ToString().ToUpper();
                    <tr>
                        <td class="text-center">
                            <span class="cliente-avatar" aria-hidden="true">@inicial</span>
                        </td>
                        <td>
                            <span class="fw-semibold">@c.NombreCompleto</span>
                            <div class="d-md-none text-muted" style="font-size:.8rem">@c.Correo</div>
                        </td>
                        <td class="text-muted d-none d-md-table-cell">@c.Correo</td>
                        <td class="text-muted d-none d-md-table-cell">@(c.Telefono ?? "—")</td>
                        <td>
                            <span class="etiqueta-estado @(c.Activo ? "etiqueta-estado--activo" : "etiqueta-estado--inactivo")">
                                @(c.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-muted d-none d-md-table-cell">@c.UltimoAccesoRelativo</td>
                        <td class="text-center">
                            <a class="btn-accion" asp-action="Editar" asp-route-id="@c.Id"
                               title="Editar" aria-label="Editar @c.NombreCompleto">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z"/>
                                </svg>
                            </a>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7">
                            <div class="estado-vacio">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5" aria-hidden="true">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                                <p>No hay clientes con esos filtros.</p>
                                @if (Model.Busqueda != null || Model.Activo != null)
                                {
                                    <a asp-action="Index">Limpiar filtros</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Total > 0 || Model.TotalPaginas > 1)
    {
        <div class="tarjeta-panel__pie">
            <p class="text-muted small mb-0">
                @if (Model.Total > 0)
                {
                    <span>Mostrando @desde–@hasta de @Model.Total</span>
                }
            </p>
            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Páginas">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="1" asp-route-q="@Model.Busqueda"
                               asp-route-activo="@Model.Activo" asp-route-orden="@Model.Orden" asp-route-dir="@Model.Dir"
                               aria-label="Primera">«</a>
                        </li>
                        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(Model.Pagina - 1)" asp-route-q="@Model.Busqueda"
                               asp-route-activo="@Model.Activo" asp-route-orden="@Model.Orden" asp-route-dir="@Model.Dir"
                               aria-label="Anterior">‹</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPaginas; p++)
                        {
                            <li class="page-item @(p == Model.Pagina ? "pagina-activa" : null)">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@p" asp-route-q="@Model.Busqueda"
                                   asp-route-activo="@Model.Activo"
                                   asp-route-orden="@Model.Orden" asp-route-dir="@Model.Dir">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@(Model.Pagina + 1)" asp-route-q="@Model.Busqueda"
                               asp-route-activo="@Model.Activo" asp-route-orden="@Model.Orden" asp-route-dir="@Model.Dir"
                               aria-label="Siguiente">›</a>
                        </li>
                        <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@Model.TotalPaginas" asp-route-q="@Model.Busqueda"
                               asp-route-activo="@Model.Activo" asp-route-orden="@Model.Orden" asp-route-dir="@Model.Dir"
                               aria-label="Última">»</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }

</div>
