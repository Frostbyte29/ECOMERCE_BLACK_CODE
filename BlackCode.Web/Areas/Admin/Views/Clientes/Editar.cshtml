@model EditarClienteViewModel
@{
    ViewData["Title"] = "Editar cliente";
}

<div class="tarjeta-panel" style="max-width:720px; margin-inline:auto">

    <div class="banda-panel">
        <div>
            <h1 class="banda-panel__titulo">Editar cliente</h1>
            <p class="banda-panel__subtitulo">Modifica los datos del cliente</p>
        </div>
        <a asp-action="Index" class="banda-panel__cerrar" aria-label="Cerrar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </a>
    </div>

    @{ var inicialEditar = string.IsNullOrEmpty(Model.NombreCompleto) ? "?" : Model.NombreCompleto[0].ToString().ToUpper(); }
    <div class="franja-identidad">
        <span class="cliente-avatar cliente-avatar--grande" aria-hidden="true">@inicialEditar</span>
        <div class="franja-identidad__datos">
            <p class="nombre">@Model.NombreCompleto</p>
            <p class="correo">@Model.Correo</p>
            <span class="etiqueta-estado @(Model.Activo ? "etiqueta-estado--activo" : "etiqueta-estado--inactivo")">
                @(Model.Activo ? "Activo" : "Inactivo")
            </span>
        </div>
        <div class="franja-identidad__meta">
            <span>Cliente desde @Model.ClienteDesde</span>
            <span>Último acceso @Model.UltimoAccesoRelativo</span>
        </div>
    </div>

    <form asp-action="Editar" asp-route-id="@Model.Id" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mx-4 mt-3" role="alert"></div>

        <div class="seccion-form">
            <h2 class="seccion-form__titulo">Datos personales</h2>

            <div class="mb-3">
                <label class="form-label text-muted small mb-1">Correo electrónico</label>
                <input type="text" class="form-control" value="@Model.Correo" readonly disabled />
                <div class="form-text">El correo no se puede cambiar.</div>
            </div>

            <div class="row g-2">
                <div class="col-md-6">
                    <label asp-for="NombreCompleto" class="form-label"></label>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" autocomplete="name" />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" placeholder="9XXXXXXXX" inputmode="numeric" maxlength="9" autocomplete="tel" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="seccion-form">
            <h2 class="seccion-form__titulo">Estado de la cuenta</h2>

            <div class="fila-estado">
                <div>
                    <p>Estado del cliente</p>
                    <p class="texto-ayuda">Al desactivarlo, su sesión actual se cerrará.</p>
                </div>
                <div class="interruptor-negro">
                    <input class="form-check-input" type="checkbox" role="switch"
                           asp-for="Activo" id="Activo" />
                    <span class="texto-activo">Activo</span>
                    <span class="texto-inactivo">Inactivo</span>
                </div>
            </div>
        </div>

        <div class="seccion-form">
            <h2 class="seccion-form__titulo">Seguridad</h2>
            <p class="text-muted small mb-3">Deja ambos campos vacíos para conservar la contraseña actual.</p>

            <div class="row g-2">
                <div class="col-md-6">
                    <label asp-for="NuevaContrasena" class="form-label"></label>
                    <input asp-for="NuevaContrasena" class="form-control"
                           placeholder="Nueva contraseña (mín. 8 caracteres)" autocomplete="new-password" />
                    <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmarContrasena" class="form-label"></label>
                    <input asp-for="ConfirmarContrasena" class="form-control"
                           placeholder="Confirmar contraseña" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="pie-form">
            <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
            <button type="submit" class="btn btn-dark">Guardar cambios</button>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
