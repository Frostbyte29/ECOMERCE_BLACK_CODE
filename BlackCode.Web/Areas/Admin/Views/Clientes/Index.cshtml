@using BlackCode.Web.ViewModels
@model ClientesListaViewModel
@{
    ViewData["Title"] = "Clientes";

    string UrlOrden(string columna)
    {
        var dirActual = string.Equals(Model.Orden, columna, StringComparison.OrdinalIgnoreCase) ? Model.Dir : null;
        var nuevaDir  = string.Equals(dirActual, "asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
        return Url.Action("Index", new { q = Model.Busqueda, activo = Model.Activo, orden = columna, dir = nuevaDir, pagina = 1 })!;
    }

    string ClaseOrden(string columna)
    {
        if (!string.Equals(Model.Orden, columna, StringComparison.OrdinalIgnoreCase)) return "ordenable";
        return string.Equals(Model.Dir, "desc", StringComparison.OrdinalIgnoreCase)
            ? "ordenable ordenable--desc" : "ordenable ordenable--asc";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes <small class="text-muted fs-6">(@Model.Total)</small></h1>
    <a asp-action="Nuevo" class="btn btn-dark btn-sm">+ Nuevo cliente</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success alert-dismissible" role="status">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <input type="hidden" name="orden" value="@Model.Orden" />
    <input type="hidden" name="dir" value="@Model.Dir" />
    <div class="col-md-7">
        <input name="q" value="@Model.Busqueda" class="form-control"
               placeholder="Buscar por nombre o correo" aria-label="Buscar" />
    </div>
    <div class="col-md-3">
        <select name="activo" class="form-select" aria-label="Estado">
            <option value="">Todos</option>
            <option value="true"  selected="@(Model.Activo == true)">Activos</option>
            <option value="false" selected="@(Model.Activo == false)">Inactivos</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-dark">Filtrar</button>
    </div>
</form>

<div class="table-responsive bg-white border rounded">
    <table class="table table-hover align-middle mb-0">
        <colgroup>
            <col style="width:52px" />
            <col />
            <col style="width:240px" />
            <col style="width:110px" />
            <col style="width:150px" />
            <col style="width:72px" />
        </colgroup>
        <thead class="table-light">
            <tr>
                <th></th>
                <th><a href="@UrlOrden("nombre")" class="@ClaseOrden("nombre")">Nombre</a></th>
                <th>Correo</th>
                <th><a href="@UrlOrden("estado")" class="@ClaseOrden("estado")">Estado</a></th>
                <th><a href="@UrlOrden("acceso")" class="@ClaseOrden("acceso")">Último acceso</a></th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td class="text-center">
                    <span class="cliente-avatar" aria-hidden="true">@c.NombreCompleto[0].ToString().ToUpper()</span>
                </td>
                <td>@c.NombreCompleto</td>
                <td class="text-muted">@c.Correo</td>
                <td>
                    <span class="badge @(c.Activo ? "text-bg-success" : "text-bg-secondary")">
                        @(c.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="text-muted">@c.UltimoAccesoRelativo</td>
                <td class="text-end">
                    <a asp-action="Editar" asp-route-id="@c.Id"
                       class="btn btn-sm btn-outline-secondary"
                       title="Editar" aria-label="Editar @c.NombreCompleto">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z"/>
                        </svg>
                    </a>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No hay clientes con esos filtros.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPaginas > 1)
{
    <nav class="mt-3" aria-label="Páginas">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPaginas; p++)
            {
                <li class="page-item @(p == Model.Pagina ? "active" : null)">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@p" asp-route-q="@Model.Busqueda"
                       asp-route-activo="@Model.Activo"
                       asp-route-orden="@Model.Orden" asp-route-dir="@Model.Dir">@p</a>
                </li>
            }
        </ul>
    </nav>
}
