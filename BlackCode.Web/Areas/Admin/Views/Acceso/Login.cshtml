@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Acceso administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BLACK CODE</title>
    <link rel="icon" type="image/png" href="~/img/marca/logo-negro.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="~/img/marca/logo-blanco.png" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />
</head>
<body>
<section class="acceso-dividido">

    <div class="acceso-dividido__foto">
        <div class="acceso-dividido__capa"></div>
        <div class="acceso-dividido__editorial">
            <p class="acceso-dividido__marca">BLACK CODE</p>
            <p class="acceso-dividido__lema">Diseño que<br />define carácter.</p>
        </div>
    </div>

    <div class="acceso-dividido__form">
        <a class="acceso-dividido__logo" href="/">
            <img src="~/img/marca/logo-negro.png" alt="BLACK CODE" height="28" />
        </a>

        <div class="acceso-dividido__contenido">
            <h1 class="cuenta__titulo">Acceso administrador</h1>
            <p class="cuenta__subtitulo">Acceso exclusivo al panel de gestión.</p>

            <form asp-area="Admin" asp-controller="Acceso" asp-action="Login" method="post" class="cuenta__form" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="cuenta__error" role="alert"></div>

                <div>
                    <label asp-for="Correo" class="cuenta__solo-lector"></label>
                    <div class="cuenta__campo">
                        <span class="cuenta__icono" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/></svg>
                        </span>
                        <input asp-for="Correo" placeholder="admin@correo.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Correo" class="cuenta__campo-error"></span>
                </div>

                <div>
                    <label asp-for="Contrasena" class="cuenta__solo-lector"></label>
                    <div class="cuenta__campo">
                        <span class="cuenta__icono" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="10" width="14" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        </span>
                        <input asp-for="Contrasena" placeholder="Contraseña" autocomplete="current-password" />
                        <button type="button" class="cuenta__ojo" data-mostrar-contrasena="Contrasena" aria-pressed="false" aria-label="Mostrar contraseña">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Contrasena" class="cuenta__campo-error"></span>
                </div>

                <div class="cuenta__fila">
                    <label class="cuenta__check">
                        <input asp-for="MantenerSesion" />
                        <span>Recordarme en este equipo</span>
                    </label>
                </div>

                <button type="submit" class="cuenta__boton cuenta__boton--oscuro">INGRESAR <span aria-hidden="true">→</span></button>
            </form>
        </div>
    </div>

</section>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/js/cuenta.js" asp-append-version="true"></script>
</body>
</html>
