@model List<Product>
@{
    ViewData["Title"] = "Administrar productos";
}
<div class="admin-shell">
    <partial name="_AdminNav" />
    <section class="admin-main">
        <partial name="_AdminTopbar" />
        <p class="eyebrow">CATÁLOGO</p>
        <div class="account-section-heading"><h1>Productos</h1><a class="button button-dark" asp-action="Nuevo">+ AÑADIR PRODUCTO</a></div>
        <p class="admin-intro">Crea y edita productos. Los cambios del catálogo aparecen en la tienda; los pedidos anteriores conservan su precio y nombre originales.</p>
        <form method="get" asp-action="Productos" class="admin-inventory-search">
            <label class="sr-only" for="product-search">Buscar producto o categoría</label>
            <input id="product-search" type="search" name="search" value="@ViewBag.Search" placeholder="Buscar producto o categoría" />
            <button class="button button-dark" type="submit">BUSCAR</button>
        </form>
        <div class="table-wrap"><table class="admin-table inventory-table"><thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Tallas</th><th></th></tr></thead><tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td><div class="inventory-product"><img src="@product.ImageUrl" alt="" /><strong>@product.Name</strong></div></td>
                    <td>@product.Category</td><td>S/ @product.Price.ToString("0.00")</td><td>@product.SizesCsv</td>
                    <td><a asp-action="Editar" asp-route-id="@product.Id">EDITAR →</a></td>
                </tr>
            }
        </tbody></table></div>
        @if (Model.Count == 0) { <p>No encontramos productos con esa búsqueda.</p> }
    </section>
</div>
