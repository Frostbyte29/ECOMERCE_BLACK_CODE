@model List<AdminCustomerRow>
@{
    ViewData["Title"] = "Clientes";
}
<div class="admin-shell">
    <partial name="_AdminNav" />
    <section class="admin-main">
        <partial name="_AdminTopbar" />
        <p class="eyebrow">ADMINISTRACIÓN</p><h1>Cuentas registradas</h1>
        <p class="admin-intro">Incluye cuentas de administración. Datos de consulta, sin cambios a perfiles.</p>
        <div class="table-wrap"><table class="admin-table"><thead><tr><th>Nombre</th><th>Correo</th><th>Pedidos</th><th>Favoritos</th><th>Direcciones</th></tr></thead><tbody>
            @foreach (var row in Model)
            {
                <tr><td>@row.Name</td><td>@row.Email</td><td>@row.Orders</td><td>@row.Favorites</td><td>@row.Addresses</td></tr>
            }
        </tbody></table></div>
        @if (Model.Count == 0) { <p>Aún no hay cuentas registradas.</p> }
    </section>
</div>
