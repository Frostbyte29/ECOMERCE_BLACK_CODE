@model ProductoViewModel
@{ViewData["Title"]=Model.Nombre;var disponibles=Model.Variantes.Where(v=>v.Activo && v.Stock>0).ToList();}
<section class="section"><p class="breadcrumb"><a href="/">Inicio</a> / <a href="/Catalogo">Colecciones</a> / @Model.Nombre</p>
<div class="detail-layout"><div class="detail-image"><img src="@Model.Imagen" alt="@Model.Nombre" /><span>BLACKCODE / OBJETOS CON IDENTIDAD</span></div><div class="detail-copy"><p class="eyebrow">@Model.Categoria · ACERO INOXIDABLE</p><h1>@Model.Nombre</h1><p class="detail-price">@Dinero(Model.Precio)</p><p>@Model.Descripcion</p><div class="detail-meta">Color <strong>@Model.Color</strong></div>
@if(disponibles.Count>0){<form asp-controller="Carrito" asp-action="Agregar" method="post"><label for="varianteId">Selecciona tu talla</label><select name="varianteId" id="varianteId" required>@foreach(var v in disponibles){<option value="@v.Id">@v.Talla — @v.Stock disponibles</option>}</select><label for="cantidad">Cantidad</label><input id="cantidad" name="cantidad" type="number" value="1" min="1" max="99"/><button class="button full">Añadir al carrito <span>+</span></button></form>}else{<p class="notice">Este producto está agotado temporalmente.</p>}
<p class="muted small">Puedes añadir productos sin crear una cuenta. El stock se confirma al finalizar tu compra.</p><details open><summary>Envíos</summary><p>Envío S/ 15.00. Gratis desde S/ 199.00. Los importes finales se muestran en tu carrito.</p></details><details><summary>Cuidados de tu pieza</summary><p>Limpia con un paño suave y evita el contacto prolongado con productos abrasivos.</p></details></div></div></section>
