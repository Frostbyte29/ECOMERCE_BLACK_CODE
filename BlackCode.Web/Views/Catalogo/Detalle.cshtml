@model ProductoViewModel
@{
    ViewData["Title"] = Model.Nombre;
    var todasImagenes = Model.Imagenes?.Count > 0 ? Model.Imagenes : new[] { Model.Imagen };
    var imagenPrincipal = todasImagenes[0];
    var variantesActivas = Model.Variantes.Where(v => v.Activo).ToList();
    var variantePresel = TempData["VarianteIdDetalle"]?.ToString();
    var cantidadPresel = TempData["CantidadDetalle"]?.ToString() ?? "1";
}
@section Styles { <partial name="_EstilosCompras" /> }
<section class="section">
    <p class="breadcrumb">
        <a href="/">Inicio</a> /
        <a href="/Catalogo?Categoria=@Model.CategoriaId">@Model.Categoria</a> /
        @Model.Nombre
    </p>
    <div class="detail-layout">
        <div>
            @if (todasImagenes.Count > 1)
            {
                <div class="gallery">
                    <div class="gallery-thumbs">
                        @foreach (var img in todasImagenes)
                        {
                            <button type="button" class="thumb @(img == imagenPrincipal ? "active" : "")" data-src="@img" aria-label="Ver imagen">
                                <img src="@img" alt="" />
                            </button>
                        }
                    </div>
                    <div class="main-product-image">
                        <img id="main-img" src="@imagenPrincipal" alt="@Model.Nombre" />
                    </div>
                </div>
            }
            else
            {
                <div class="main-product-image">
                    <img id="main-img" src="@imagenPrincipal" alt="@Model.Nombre" />
                </div>
            }
        </div>
        <div class="product-info">
            <p class="eyebrow">@Model.Categoria.ToUpperInvariant()</p>
            <h1>@Model.Nombre</h1>
            <p class="detail-price">@Dinero(Model.Precio)</p>
            <p class="description">@Model.Descripcion</p>
            <div class="specs">
                <div>
                    <span>MATERIAL</span>
                    <b>@Model.Material</b>
                    @if (Model.MaterialDescripcion != null)
                    {
                        <small style="color:#777;font-size:10px;display:block;margin-top:4px">@Model.MaterialDescripcion</small>
                    }
                </div>
            </div>
            <form asp-controller="Carrito" asp-action="Agregar" method="post" class="buy-form" id="buy-form" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="varianteId" id="variante-hidden" value="@(variantePresel ?? "")" />
                <input type="hidden" name="productoId" value="@Model.Id" />
                @if (TempData["Error"] != null)
                {
                    <p class="notice error">@TempData["Error"]</p>
                }
                <div class="size-heading">
                    <label class="quantity-label">TALLA</label>
                </div>
                <div class="sizes">
                    @foreach (var v in variantesActivas)
                    {
                        <label class="size-option">
                            <input type="radio" name="_talla" value="@v.Id"
                                   data-stock="@v.Stock" data-talla="@v.Talla"
                                   @(v.Stock == 0 ? "disabled" : "")
                                   @(variantePresel == v.Id.ToString() ? "checked" : "") />
                            <span>@v.Talla</span>
                        </label>
                    }
                </div>
                <p id="talla-error" class="field-validation-error" hidden>Selecciona una talla</p>
                <span class="quantity-label">CANTIDAD</span>
                <div class="buy-row">
                    <div class="stepper">
                        <button type="button" id="btn-menos" aria-label="Reducir cantidad">−</button>
                        <input type="number" id="cantidad" name="cantidad" value="@cantidadPresel"
                               min="1" max="99" aria-label="Cantidad" />
                        <button type="button" id="btn-mas" aria-label="Aumentar cantidad">+</button>
                    </div>
                    <span class="stock" id="stock-info" hidden>
                        <i></i><span id="stock-texto"></span>
                    </span>
                </div>
                <p id="cantidad-error" class="field-validation-error" hidden></p>
                <button type="submit" class="button full" id="btn-agregar">Agregar al carrito</button>
                <div class="service-points">
                    <div>
                        <span><b>Pago seguro</b><small>Tarjeta, Yape y Plin</small></span>
                    </div>
                    <div>
                        <span><b>Envíos a todo el Perú</b><small>2 a 4 días hábiles</small></span>
                    </div>
                    <div>
                        <span><b>Cambios fáciles</b><small>7 días desde la recepción</small></span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
<script>
(function () {
    var variantes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Variantes.Where(v => v.Activo).Select(v => new { v.Id, v.Stock, v.Talla })));

    var hiddenVar = document.getElementById('variante-hidden');
    var cantInput = document.getElementById('cantidad');
    var btnMenos  = document.getElementById('btn-menos');
    var btnMas    = document.getElementById('btn-mas');
    var stockInfo = document.getElementById('stock-info');
    var stockTxt  = document.getElementById('stock-texto');
    var tallaErr  = document.getElementById('talla-error');
    var cantErr   = document.getElementById('cantidad-error');
    var btnAgregar = document.getElementById('btn-agregar');
    var form      = document.getElementById('buy-form');
    var stockActual = 0;
    var tallaActual = '';

    function variantePorId(id) {
        return variantes.find(function (v) { return v.Id === id; });
    }

    function actualizarStock(varianteId) {
        var v = variantePorId(varianteId);
        if (!v) return;
        stockActual = v.Stock;
        tallaActual = v.Talla;
        cantInput.max = v.Stock;
        stockInfo.removeAttribute('hidden');
        if (v.Stock === 0) {
            stockTxt.textContent = 'Agotado';
            btnAgregar.disabled = true;
            btnAgregar.textContent = 'Agotado';
        } else {
            btnAgregar.disabled = false;
            btnAgregar.textContent = 'Agregar al carrito';
            stockTxt.textContent = v.Stock <= 3
                ? 'Últimas ' + v.Stock + ' unidades'
                : 'En existencia (' + v.Stock + ')';
        }
        var qty = parseInt(cantInput.value) || 1;
        if (v.Stock > 0 && qty > v.Stock) cantInput.value = v.Stock;
    }

    document.querySelectorAll('input[name="_talla"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
            tallaErr.setAttribute('hidden', '');
            hiddenVar.value = this.value;
            actualizarStock(parseInt(this.value));
        });
        if (radio.checked && radio.value) {
            hiddenVar.value = radio.value;
            actualizarStock(parseInt(radio.value));
        }
    });

    // Thumbnails
    document.querySelectorAll('.thumb').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.thumb').forEach(function (b) { b.classList.remove('active'); });
            this.classList.add('active');
            document.getElementById('main-img').src = this.dataset.src;
        });
    });

    btnMenos.addEventListener('click', function () {
        var v = parseInt(cantInput.value) || 1;
        if (v > 1) { cantInput.value = v - 1; cantErr.setAttribute('hidden', ''); }
    });

    btnMas.addEventListener('click', function () {
        var v = parseInt(cantInput.value) || 1;
        if (stockActual === 0) return;
        if (v < stockActual && v < 99) {
            cantInput.value = v + 1;
            cantErr.setAttribute('hidden', '');
        } else {
            cantErr.textContent = 'Solo hay ' + stockActual + ' unidades disponibles en talla ' + tallaActual;
            cantErr.removeAttribute('hidden');
        }
    });

    cantInput.addEventListener('change', function () {
        if (!hiddenVar.value) return;
        var v = parseInt(this.value) || 1;
        if (v < 1) { this.value = 1; return; }
        if (stockActual > 0 && v > stockActual) {
            cantErr.textContent = 'Solo hay ' + stockActual + ' unidades disponibles en talla ' + tallaActual;
            cantErr.removeAttribute('hidden');
            this.value = stockActual;
        } else {
            cantErr.setAttribute('hidden', '');
        }
    });

    form.addEventListener('submit', function (e) {
        if (!hiddenVar.value) {
            e.preventDefault();
            tallaErr.removeAttribute('hidden');
        }
    });
}());
</script>
}
