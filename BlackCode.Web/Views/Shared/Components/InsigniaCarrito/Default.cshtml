@model int
<a asp-controller="Carrito" asp-action="Index" class="cart-link" aria-label="Carrito de compras" title="Carrito de compras">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <line x1="3" y1="6" x2="21" y2="6" />
        <path d="M16 10a4 4 0 0 1-8 0" />
    </svg>
    @if (Model > 0)
    {
        <span class="cart-badge" aria-live="polite" aria-label="@Model unidades en el carrito">@Model</span>
    }
</a>
