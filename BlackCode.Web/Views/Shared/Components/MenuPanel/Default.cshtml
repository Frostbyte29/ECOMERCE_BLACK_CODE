@using BlackCode.Web.ViewComponents
@model IReadOnlyList<ModuloPanel>
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
}

@foreach (var modulo in Model)
{
    var esActivo = string.Equals(controladorActual, modulo.Controlador, StringComparison.OrdinalIgnoreCase);
    <a asp-area="@modulo.Area" asp-controller="@modulo.Controlador" asp-action="Index"
       class="panel__menu-item @(esActivo ? "panel__menu-item--activo" : null)">
        <svg class="panel__menu-icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        @modulo.Nombre
    </a>
}
