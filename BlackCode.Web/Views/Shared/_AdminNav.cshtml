@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<aside class="admin-sidebar">
    <div class="admin-sidebar-top">
        <a class="admin-brand" asp-controller="Admin" asp-action="Index"><span class="brand-emblem"><img src="~/images/brand/monograma-claro.jpeg" alt="" /></span><span class="brand-wordmark">BLACK <span>CODE</span></span></a>
        <button class="admin-menu-toggle" type="button" aria-label="Abrir menú de administración" aria-expanded="false" aria-controls="admin-navigation" data-admin-menu-toggle>☰</button>
    </div>
    <div class="admin-sidebar-content" id="admin-navigation">
        <nav aria-label="Administración">
            <a asp-controller="Admin" asp-action="Index" aria-current="@(controller == "Admin" && action == "Index" ? "page" : null)"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-7v-7h-4v7H3z" /></svg><span>Resumen</span><span class="admin-nav-arrow">›</span></a>
            <a asp-controller="AdminCatalogo" asp-action="Productos" aria-current="@(controller == "AdminCatalogo" && (action == "Productos" || action == "Nuevo" || action == "Editar") ? "page" : null)"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7zM3 7l9 5 9-5M12 12v10" /></svg><span>Productos</span><span class="admin-nav-arrow">›</span></a>
            <a asp-controller="Admin" asp-action="Inventario" aria-current="@(controller == "Admin" && action != "Index" ? "page" : null)"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM4 9h16M8 13h8M8 17h5" /></svg><span>Inventario</span><span class="admin-nav-arrow">›</span></a>
            <a asp-controller="AdminPedidos" asp-action="Index" aria-current="@(controller == "AdminPedidos" ? "page" : null)"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16l-1 13H5L4 8zM9 9V6a3 3 0 0 1 6 0v3" /></svg><span>Pedidos</span><span class="admin-nav-arrow">›</span></a>
            <a asp-controller="AdminClientes" asp-action="Index" aria-current="@(controller == "AdminClientes" ? "page" : null)"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3.5" /><path d="M4 21c0-4.4 3-7 8-7s8 2.6 8 7z" /></svg><span>Usuarios</span><span class="admin-nav-arrow">›</span></a>
            <a asp-controller="AdminCatalogo" asp-action="Reportes" aria-current="@(controller == "AdminCatalogo" && action == "Reportes" ? "page" : null)"><svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 18v-6h3v6M10.5 18V5h3v13M16 18V9h3v9" /></svg><span>Reportes</span><span class="admin-nav-arrow">›</span></a>
        </nav>
        <div class="admin-sidebar-bottom">
            <div class="admin-sidebar-feature"><span>PIEZAS QUE HABLAN<br />DE ACTITUD.</span><img src="~/images/admin/anillo-textura-negra.png" alt="Anillo de estilo BLACK CODE" /></div>
            <a class="admin-back" asp-controller="Home" asp-action="Index">← Volver a la tienda</a>
            <small>BLACK CODE<br />ADMIN</small>
        </div>
    </div>
</aside>
