<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BLACK CODE</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="announcement">ENVÍOS A TODO EL PERÚ <span>|</span> CAMBIOS FÁCILES <span>|</span> PAGA SEGURO</div>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index">BLACK <span>CODE</span></a>
        <nav class="main-nav">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a href="/#colecciones">Colecciones⌄</a>
            <a asp-controller="Home" asp-action="Index" asp-fragment="productos">Anillos</a>
            <a href="/#productos">Cadenas</a>
            <a href="/#productos">Pulseras</a>
            <a href="/#nosotros">Nosotros</a>
        </nav>
        <div class="header-actions"><span class="search-icon">⌕</span><a href="/#cuenta">♙ <span class="hello">Hola, Carlos</span></a><a href="/#favoritos" aria-label="Favoritos">♡</a><a href="/#carrito" aria-label="Carrito">♧</a></div>
    </header>
    <main>@RenderBody()</main>
    <footer class="footer"><a class="brand" asp-controller="Home" asp-action="Index">BLACK <span>CODE</span></a><p>Diseñado para marcar la diferencia.</p><small>© @DateTime.Now.Year BLACK CODE. Proyecto de demostración.</small></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
