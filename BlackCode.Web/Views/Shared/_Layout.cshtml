@using BlackCode.Domain.Usuarios
@{
    var _catId = Context.Request.Query["Categoria"].ToString();
    bool _enCatalogo = (Context.Request.Path.Value ?? "").StartsWith("/Catalogo");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BLACK CODE</title>
    <link rel="icon" type="image/png" href="~/img/marca/logo-negro.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="~/img/marca/logo-blanco.png" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="~/css/blackcode.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<div class="announcement">
    ENVÍOS A TODO EL PERÚ <span>|</span> CAMBIOS FÁCILES <span>|</span> PAGA SEGURO
</div>

<header class="site-header">
    <a class="brand" asp-controller="Home" asp-action="Index"><img src="~/img/marca/logo-negro.png" class="brand__logo" alt="" />BLACK <span>CODE</span></a>

    <nav class="main-nav" aria-label="Navegación principal">
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <a asp-controller="Catalogo" asp-action="Index">Colecciones</a>
        <a href="/Catalogo?Categoria=1" class="@(_enCatalogo&&_catId=="1"?"active":null)" aria-current="@(_enCatalogo&&_catId=="1"?"page":null)">Anillos</a>
        <a href="/Catalogo?Categoria=2" class="@(_enCatalogo&&_catId=="2"?"active":null)" aria-current="@(_enCatalogo&&_catId=="2"?"page":null)">Cadenas</a>
        <a href="/Catalogo?Categoria=3" class="@(_enCatalogo&&_catId=="3"?"active":null)" aria-current="@(_enCatalogo&&_catId=="3"?"page":null)">Pulseras</a>
        <a href="#">Nosotros</a>
    </nav>

    <div class="header-actions">
        <span class="search-icon" aria-hidden="true">⌕</span>
        @await Component.InvokeAsync("MenuCuenta")
        <a href="#" aria-label="Favoritos">♡</a>
        @if (!User.IsInRole(nameof(RolUsuario.Admin)))
        {
            <a asp-controller="Carrito" asp-action="Index" aria-label="Carrito"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
        }
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer class="footer">
    <div class="footer__grid">
        <div class="footer__marca">
            <a class="brand" asp-controller="Home" asp-action="Index">BLACK <span>CODE</span></a>
            <p>Diseñado para marcar la diferencia.</p>
        </div>
        <div class="footer__col">
            <h4>Comprar</h4>
            <ul>
                <li><a href="/Catalogo?Buscar=anillo">Anillos</a></li>
                <li><a href="/Catalogo?Buscar=cadena">Cadenas</a></li>
                <li><a href="/Catalogo?Buscar=pulsera">Pulseras</a></li>
                <li><a asp-controller="Catalogo" asp-action="Index">Colecciones</a></li>
            </ul>
        </div>
        <div class="footer__col">
            <h4>Nosotros</h4>
            <ul>
                <li><a href="#">Quiénes somos</a></li>
                <li><a href="#">Nuestra historia</a></li>
            </ul>
        </div>
        <div class="footer__col">
            <h4>Ayuda</h4>
            <ul>
                <li><a href="#">Preguntas frecuentes</a></li>
                <li><a href="#">Envíos y devoluciones</a></li>
                <li><a asp-controller="Cuenta" asp-action="Index">Mi cuenta</a></li>
            </ul>
        </div>
        <div class="footer__col">
            <h4>Síguenos</h4>
            <ul>
                <li><a href="#">Instagram</a></li>
                <li><a href="#">TikTok</a></li>
                <li><a href="#">Facebook</a></li>
            </ul>
        </div>
    </div>
    <div class="footer__bottom">
        <span>&copy; @DateTime.Now.Year BLACK CODE. Todos los derechos reservados.</span>
        <div class="footer__legal">
            <a href="/terminos">Términos y Condiciones</a>
            <a href="/privacidad">Política de Privacidad</a>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/menu-cuenta.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
