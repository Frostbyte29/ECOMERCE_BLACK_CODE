@model CartSummary
@{
    ViewData["Title"] = "Carrito";
}
<section class="cart-page">
    <div class="catalog-breadcrumb"><a asp-controller="Home" asp-action="Index">Inicio</a><span>›</span><span>Carrito</span></div>
    <div class="cart-page-heading"><div><h1>Tu carrito</h1><p>@Model.ItemCount pieza@(Model.ItemCount == 1 ? "" : "s") en tu carrito</p></div><a class="text-link" asp-controller="Productos" asp-action="Index">SEGUIR COMPRANDO →</a></div>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <p>Tu carrito está vacío.</p>
            <a class="button button-dark" asp-controller="Productos" asp-action="Index">EXPLORAR PIEZAS</a>
        </div>
    }
    else
    {
        <div class="cart-page-layout">
            <div class="cart-items">
                @foreach (var line in Model.Lines)
                {
                    <div class="cart-line">
                        <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@line.Product.Id" class="cart-thumb"><img src="@line.Product.ImageUrl" alt="@line.Product.Name" /></a>
                        <div class="cart-line-info">
                            <b><a asp-controller="Productos" asp-action="Detalle" asp-route-id="@line.Product.Id">@line.Product.Name</a></b>
                            <span>S/ @line.Product.Price.ToString("0.00")</span>
                            @if (line.Size is not null) { <small>Talla: @line.Size</small> }
                            <small>Acabado: @line.Product.Finish</small>
                        </div>
                        <form asp-action="Actualizar" method="post" class="qty-form">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="size" value="@line.Size" />
                            <div class="cart-qty-control"><button type="button" data-cart-quantity-change="-1" aria-label="Disminuir cantidad">−</button><input type="number" name="quantity" min="1" max="@CartService.MaxQuantityPerLine" value="@line.Quantity" aria-label="Cantidad" onchange="this.form.submit()" /><button type="button" data-cart-quantity-change="1" aria-label="Aumentar cantidad">+</button></div>
                        </form>
                        <span class="cart-line-total">S/ @line.LineTotal.ToString("0.00")</span>
                        <form asp-action="Eliminar" method="post">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="size" value="@line.Size" />
                            <button type="submit" class="link-button cart-remove" aria-label="Quitar @line.Product.Name">Eliminar</button>
                        </form>
                    </div>
                }
                <div class="cart-bottom-actions"><a class="button button-outline" asp-controller="Productos" asp-action="Index">← SEGUIR COMPRANDO</a><form asp-action="Vaciar" method="post"><button type="submit" class="link-button cart-clear">Vaciar carrito</button></form></div>
            </div>
            <aside class="summary-box cart-summary">
                <h3>Resumen del pedido</h3>
                <div class="summary-totals">
                    <div><span>Subtotal</span><span>S/ @Model.Subtotal.ToString("0.00")</span></div>
                    <div><span>Envío</span><span>@(Model.ShippingCost == 0 ? "Gratis" : "S/ " + Model.ShippingCost.ToString("0.00"))</span></div>
                    <div class="summary-total"><span>Total</span><strong>S/ @Model.Total.ToString("0.00")</strong></div>
                </div>
                @if (Model.ShippingCost > 0)
                {
                    <p class="muted small">Te faltan S/ @((CartService.FreeShippingFrom - Model.Subtotal).ToString("0.00")) para el envío gratis.</p>
                }
                <a class="button button-dark full-width" asp-controller="Checkout" asp-action="Index">CONTINUAR COMPRA →</a>
            </aside>
        </div>
    }
</section>
