@{
    ViewData["Title"] = "Mi cuenta";
}
<link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />

@if (ViewBag.Ok is string ok)
{
    <div class="micuenta__aviso" role="status">@ok</div>
}

<section class="micuenta">
    <div class="micuenta__cabecera">
        <h1 class="micuenta__titulo">Mi cuenta</h1>
        <p class="micuenta__bienvenida">Hola, <strong>@User.Identity!.Name</strong>. Gestiona tus pedidos, colecciones y configuración personal.</p>
    </div>

    <div class="micuenta__grilla">
        <a href="#" class="micuenta__tarjeta micuenta__tarjeta--pronto" aria-disabled="true" tabindex="-1">
            <span class="micuenta__icono" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </span>
            <span class="micuenta__nombre">Mis pedidos</span>
            <span class="micuenta__desc">Seguí el estado de tus compras</span>
        </a>

        <a href="#" class="micuenta__tarjeta micuenta__tarjeta--pronto" aria-disabled="true" tabindex="-1">
            <span class="micuenta__icono" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/>
                </svg>
            </span>
            <span class="micuenta__nombre">Favoritos</span>
            <span class="micuenta__desc">Tus piezas guardadas para después</span>
        </a>

        <a href="#" class="micuenta__tarjeta micuenta__tarjeta--pronto" aria-disabled="true" tabindex="-1">
            <span class="micuenta__icono" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
            </span>
            <span class="micuenta__nombre">Direcciones</span>
            <span class="micuenta__desc">Gestiona tus direcciones de envío</span>
        </a>

        <a asp-controller="Cuenta" asp-action="CambiarContrasena" class="micuenta__tarjeta">
            <span class="micuenta__icono" aria-hidden="true">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="5" y="10" width="14" height="11" rx="1"/>
                    <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                </svg>
            </span>
            <span class="micuenta__nombre">Cambiar contraseña</span>
            <span class="micuenta__desc">Actualiza tu clave de acceso</span>
        </a>
    </div>
</section>

<style>
.micuenta__aviso {
    max-width: 720px;
    margin: 1.5rem auto 0;
    padding: .875rem 1.25rem;
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
    font-size: .9rem;
}
.micuenta {
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 0 1.25rem;
}
.micuenta__cabecera { margin-bottom: 2rem; }
.micuenta__titulo { font-size: 1.6rem; font-weight: 800; letter-spacing: 1px; margin-bottom: .4rem; }
.micuenta__bienvenida { color: #666; font-size: .95rem; }
.micuenta__grilla {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}
.micuenta__tarjeta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .5rem;
    padding: 1.5rem 1.25rem;
    border: 1.5px solid #e5e5e5;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    background: #fff;
    transition: border-color .2s, box-shadow .2s;
}
.micuenta__tarjeta:hover {
    border-color: #111;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
    color: inherit;
}
.micuenta__tarjeta--pronto {
    opacity: .55;
    pointer-events: none;
}
.micuenta__icono { color: #111; }
.micuenta__nombre { font-weight: 700; font-size: 1rem; }
.micuenta__desc { font-size: .83rem; color: #777; }
@@media (max-width: 520px) {
    .micuenta__grilla { grid-template-columns: 1fr; }
}
</style>
