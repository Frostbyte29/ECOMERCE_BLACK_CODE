@model BlackCode.Web.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<section class="section auth-page">
    <form asp-action="Registro" method="post" class="form-card">
        <h2>Crear cuenta</h2>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        <div class="field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
        <div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
        <div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
        <button type="submit" class="button button-dark full-width">CREAR CUENTA</button>
        <p class="small">¿Ya tienes cuenta? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl"><b>Inicia sesión</b></a></p>
    </form>
</section>
