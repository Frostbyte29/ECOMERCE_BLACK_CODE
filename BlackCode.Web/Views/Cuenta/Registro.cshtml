@model BlackCode.Web.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<section class="auth-shell">
    <div class="auth-art auth-art-register"><img src="/images/auth/registro-black-code.png" alt="" /><div><p class="eyebrow">BLACK CODE</p><h1>Hazlo<br />tuyo.</h1></div></div>
    <form asp-action="Registro" method="post" class="form-card auth-form">
        <p class="eyebrow">ÚNETE A BLACK CODE</p>
        <h2>Crear cuenta</h2>
        <p class="auth-intro">Crea una cuenta para comprar y consultar tus pedidos.</p>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        <div class="field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" required maxlength="120" /><span asp-validation-for="FullName"></span></div>
        <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" required /><span asp-validation-for="Email"></span></div>
        <div class="field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" type="tel" autocomplete="tel" inputmode="tel" placeholder="987654321" /><span asp-validation-for="PhoneNumber"></span></div>
        <div class="field"><label asp-for="Password"></label><div class="password-field"><input asp-for="Password" autocomplete="new-password" minlength="6" required /><partial name="_PasswordEyeButton" model='"Password"' /></div><span asp-validation-for="Password"></span></div>
        <div class="field"><label asp-for="ConfirmPassword"></label><div class="password-field"><input asp-for="ConfirmPassword" autocomplete="new-password" minlength="6" required /><partial name="_PasswordEyeButton" model='"ConfirmPassword"' /></div><span asp-validation-for="ConfirmPassword"></span></div>
        <button type="submit" class="button button-dark full-width">CREAR CUENTA</button>
        <p class="auth-switch">¿Ya tienes cuenta? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Iniciar sesión →</a></p>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
