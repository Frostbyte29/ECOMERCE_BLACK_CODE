@model List<Order>
@{
    ViewData["Title"] = "Mis pedidos";
}
<section class="section page-narrow">
    <div class="section-heading"><div><h2>Mis pedidos</h2><p>HISTORIAL DE COMPRAS</p></div></div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>Todavía no tienes pedidos.</p>
            <a class="button button-dark" asp-controller="Home" asp-action="Index" asp-fragment="productos">EXPLORAR PIEZAS</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <a class="order-card" asp-action="Detalle" asp-route-id="@order.Id">
                    <div class="order-card-thumbs">
                        @foreach (var item in order.Items.Take(3))
                        {
                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                        }
                    </div>
                    <div class="order-card-info">
                        <b>@order.Code</b>
                        <small>@PeruTime.Format(order.CreatedAt) · @order.ItemCount pieza(s)</small>
                        <small>@string.Join(", ", order.Items.Select(i => i.ProductName))</small>
                    </div>
                    <div class="order-card-side">
                        <partial name="_OrderStatusBadge" model="order.Status" />
                        <b>S/ @order.Total.ToString("0.00")</b>
                    </div>
                </a>
            }
        </div>
    }
</section>
