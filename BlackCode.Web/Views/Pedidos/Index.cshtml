@model List<Order>
@{
    ViewData["Title"] = "Mis pedidos";
}
<div class="account-shell">
    <partial name="_AccountNav" />
    <section class="account-main">
    <p class="eyebrow">HISTORIAL DE COMPRAS</p>
    <h1>Mis pedidos</h1>
    <p class="account-intro">Aquí puedes consultar el estado y los detalles de tus compras.</p>

    @if (Model.Count == 0)
    {
        <div class="account-empty account-empty-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16l-1 13H5L4 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
            <p>Todavía no tienes pedidos.</p>
            <a class="button button-dark" asp-controller="Productos" asp-action="Index">EXPLORAR PIEZAS</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <a class="order-card" asp-action="Detalle" asp-route-id="@order.Id">
                    <div class="order-card-thumbs">
                        @foreach (var item in order.Items.Take(3))
                        {
                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                        }
                    </div>
                    <div class="order-card-info">
                        <b>@order.Code</b>
                        <small>@PeruTime.Format(order.CreatedAt) · @order.ItemCount pieza(s)</small>
                        @if (order.Status == OrderStatus.PendientePago) { <small>Pago pendiente hasta el @PeruTime.Format(OrderService.PaymentDueAt(order))</small> }
                        <small>@string.Join(", ", order.Items.Select(i => i.ProductName))</small>
                    </div>
                    <div class="order-card-side">
                        <partial name="_OrderStatusBadge" model="order.Status" />
                        <b>S/ @order.Total.ToString("0.00")</b>
                    </div>
                </a>
            }
        </div>
    }
    </section>
</div>
