@model CheckoutViewModel
@using BlackCode.Application.Features.Configuracion
@inject IPoliticaComercialService _politicaSvc
@{
    ViewData["Title"] = "Finalizar compra";
    var _politica = await _politicaSvc.ObtenerAsync();
}
@section Styles {
    <partial name="_EstilosCompras" />
    <link rel="stylesheet" href="~/css/pagos-qr.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pagos-qr.js" asp-append-version="true" defer></script>
    <script src="~/js/checkout-tarjeta.js" asp-append-version="true" defer></script>
}
<section class="section">
    <p class="breadcrumb"><a href="/Carrito">Carrito</a> / Datos de envío / Confirmación</p>
    <div class="section-heading"><div><p class="eyebrow">UN PASO MÁS</p><h1>Hazlas tuyas.</h1></div></div>
    <form asp-action="Checkout" method="post" class="checkout-layout">
        <div>
            <h2>¿A dónde enviamos tu pedido?</h2>
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-grid">
                <div><label asp-for="Nombre">Nombre completo</label><input asp-for="Nombre" autocomplete="name" /><span asp-validation-for="Nombre"></span></div>
                <div><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" autocomplete="tel" inputmode="numeric" maxlength="9" /><span asp-validation-for="Telefono"></span></div>
                <div class="wide"><label asp-for="Direccion">Dirección</label><input asp-for="Direccion" autocomplete="street-address" /><span asp-validation-for="Direccion"></span></div>
                <div><label asp-for="Distrito">Distrito / ciudad</label><input asp-for="Distrito" /><span asp-validation-for="Distrito"></span></div>
                <div><label asp-for="Referencia">Referencia (opcional)</label><input asp-for="Referencia" /><span asp-validation-for="Referencia"></span></div>
            </div>
            <div class="payment-box">
                <p class="eyebrow">MÉTODO DE PAGO</p>
                <h3>¿Cómo quieres pagar?</h3>
                <label asp-for="MetodoPago">Elige una opción</label>
                <select asp-for="MetodoPago" data-metodo-pago aria-controls="codigos-qr">
                    @foreach (var metodo in Model.Metodos)
                    {
                        <option value="@metodo.Codigo">@metodo.Nombre</option>
                    }
                </select>
                <span asp-validation-for="MetodoPago"></span>
                <div id="tarjeta-form" hidden>
                    <div class="form-grid">
                        <div class="wide"><label for="card-numero">Número de tarjeta</label><input id="card-numero" type="text" inputmode="numeric" autocomplete="cc-number" maxlength="23" placeholder="0000 0000 0000 0000" /></div>
                        <div><label for="card-expiry">Vencimiento</label><input id="card-expiry" type="text" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="MM/AA" /></div>
                        <div><label for="card-cvv">CVV</label><input id="card-cvv" type="text" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="000" /></div>
                    </div>
                    <input type="hidden" asp-for="TarjetaMarca" />
                    <input type="hidden" asp-for="TarjetaUltimos" />
                </div>
                <div id="operacion-form" hidden>
                    <div><label asp-for="NumeroOperacion">Número de operación (opcional)</label><input asp-for="NumeroOperacion" inputmode="numeric" maxlength="20" placeholder="Código de la operación" /></div>
                </div>
                <div id="codigos-qr" aria-live="polite">
                    @foreach (var metodo in Model.Metodos.Where(m => m.ImagenQr is not null))
                    {
                        <section class="pago-qr" data-qr-metodo="@metodo.Codigo" hidden="@(Model.MetodoPago != metodo.Codigo)">
                            <h4>Código QR de @metodo.Nombre</h4>
                            @if (metodo.QrDisponible)
                            {
                                <img class="pago-qr__imagen" src="@metodo.ImagenQr" asp-append-version="true" alt="Código QR de @metodo.Nombre de Black Code" width="240" height="240" />
                            }
                            else
                            {
                                <p class="small muted">El código QR de @metodo.Nombre todavía no está disponible.</p>
                            }
                            <p class="pago-qr__importe">Total del pedido: <strong>@Dinero(Model.Carrito.Totales.Total)</strong></p>
                        </section>
                    }
                </div>
                @if (Model.MostrarRechazo)
                {
                    <label class="checkbox"><input asp-for="SimularRechazo" /> Forzar rechazo</label>
                }
            </div>
        </div>
        <aside class="order-summary">
            <h2>Tu pedido</h2>
            @foreach (var l in Model.Carrito.Lineas)
            {
                <div class="mini-line"><img src="@l.Imagen" alt="" /><div>@l.Nombre<small>Talla @l.Talla · @l.Cantidad @(l.Cantidad == 1 ? "unidad" : "unidades")</small></div><span>@Dinero(l.Total)</span></div>
            }
            <partial name="_Totales" model="Model.Carrito.Totales" />
            <button class="button full" data-submit-once>Confirmar compra →</button>
            <p class="small muted">Envío estimado: @_politica.PlazoDias.</p>
            <p class="small muted">El precio y las existencias se vuelven a comprobar al confirmar.</p>
        </aside>
    </form>
</section>
