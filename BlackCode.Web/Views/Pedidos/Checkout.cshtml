@model CheckoutViewModel
@{ViewData["Title"]="Finalizar compra";}
<section class="section"><p class="breadcrumb"><a href="/Carrito">Carrito</a> / Datos de envío / Confirmación</p><div class="section-heading"><div><p class="eyebrow">UN PASO MÁS</p><h1>Hazlas tuyas.</h1></div></div><form asp-action="Checkout" method="post" class="checkout-layout"><div><h2>¿A dónde enviamos tu pedido?</h2><div asp-validation-summary="ModelOnly"></div><div class="form-grid"><div><label asp-for="Nombre">Nombre completo</label><input asp-for="Nombre" autocomplete="name"/><span asp-validation-for="Nombre"></span></div><div><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" autocomplete="tel"/><span asp-validation-for="Telefono"></span></div><div class="wide"><label asp-for="Direccion">Dirección</label><input asp-for="Direccion" autocomplete="street-address"/><span asp-validation-for="Direccion"></span></div><div><label asp-for="Distrito">Distrito / ciudad</label><input asp-for="Distrito"/><span asp-validation-for="Distrito"></span></div><div><label asp-for="Referencia">Referencia (opcional)</label><input asp-for="Referencia"/><span asp-validation-for="Referencia"></span></div></div><div class="payment-box"><p class="eyebrow">MÉTODO DE PAGO</p><h3>Pago de demostración</h3><label asp-for="MetodoPago">Elige una opción</label><select asp-for="MetodoPago">@foreach(var metodo in Model.Metodos){<option value="@metodo.Codigo">@metodo.Nombre</option>}</select><span asp-validation-for="MetodoPago"></span><p>No se solicitarán datos de tarjeta ni se realizará ningún cobro.</p><label class="checkbox"><input asp-for="SimularRechazo"/> Simular un pago rechazado</label></div></div><aside class="order-summary"><h2>Tu pedido</h2>@foreach(var l in Model.Carrito.Lineas){<div class="mini-line"><img src="@l.Imagen" alt=""/><div>@l.Nombre<small>Talla @l.Talla · @l.Cantidad unidades</small></div><span>@Dinero(l.Total)</span></div>}<partial name="_Totales" model="Model.Carrito.Totales"/><button class="button full" data-submit-once>Confirmar compra →</button><p class="small muted">El precio y las existencias se vuelven a comprobar al confirmar.</p></aside></form></section>
