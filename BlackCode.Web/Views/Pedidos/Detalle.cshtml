@model Order
@{
    ViewData["Title"] = $"Pedido {Model.Code}";
}
<div class="account-shell">
    <partial name="_AccountNav" />
    <section class="account-main">
    <a class="account-back-link" asp-action="Index">← VOLVER A MIS PEDIDOS</a>
    <p class="eyebrow">REALIZADO EL @PeruTime.Format(Model.CreatedAt)</p>
    <div class="account-section-heading"><h1>Pedido @Model.Code</h1><partial name="_OrderStatusBadge" model="Model.Status" /></div>
    @if (Model.Status == OrderStatus.PendientePago)
    {
        <div class="payment-deadline"><strong>Tienes 3 días para completar el pago</strong><span>Plazo: hasta el @PeruTime.Format(OrderService.PaymentDueAt(Model)) (hora de Perú). Si no pagas, el pedido se cancelará automáticamente.</span></div>
    }
    <div class="checkout-layout">
        <div><partial name="_OrderInfo" model="Model" /></div>
        <aside>
            <partial name="_OrderItems" model="Model" />
            @if (Model.Status == OrderStatus.PendientePago)
            {
                <a class="button button-dark full-width" asp-controller="Checkout" asp-action="Pagar" asp-route-id="@Model.Id">COMPLETAR PAGO</a>
            }
            @if (OrderService.CustomerCanCancel(Model))
            {
                <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Seguro que quieres cancelar este pedido?');">
                    <button type="submit" class="button button-outline full-width">CANCELAR PEDIDO</button>
                </form>
            }
        </aside>
    </div>
    </section>
</div>
