@model PedidoViewModel
@{ViewData["Title"]="Pedido "+Model.Codigo;}
<section class="section"><p class="breadcrumb"><a href="/Pedidos">Mis pedidos</a> / @Model.Codigo</p><div class="section-heading"><div><p class="eyebrow">TU SELECCIÓN ESTÁ REGISTRADA</p><h1>@Model.Codigo</h1></div><span class="badge">@Estado(Model.Estado)</span></div><div class="checkout-layout"><div><h2>Detalles de la compra</h2><div class="table-scroll"><table><thead><tr><th>Producto</th><th>Talla</th><th>Cantidad</th><th>Importe</th></tr></thead><tbody>@foreach(var l in Model.Lineas){<tr><td>@l.Producto</td><td>@l.Talla</td><td>@l.Cantidad</td><td>@Dinero(l.Total)</td></tr>}</tbody></table></div><h2>Seguimiento</h2><ol class="timeline">@foreach(var h in Model.Historial){<li><strong>@Estado(h.Estado)</strong><span>@h.Fecha.ToString("dd/MM/yyyy HH:mm") UTC</span></li>}</ol></div><aside class="order-summary"><h2>Resumen</h2><partial name="_Totales" model="@(new TotalesViewModel(Model.Subtotal,0,Model.Envio,Model.Total))"/><h3>Dirección de envío</h3><p>@Model.Cliente<br/>@Model.Direccion<br/>@Model.Distrito</p><p class="small muted">Pago simulado. Este prototipo no realiza cobros ni envíos reales.</p></aside></div></section>
