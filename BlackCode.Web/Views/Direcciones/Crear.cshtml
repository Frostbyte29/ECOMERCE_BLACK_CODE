@model DireccionFormViewModel
@{ViewData["Title"] = "Nueva dirección";}
@section Styles { <partial name="_EstilosCompras" /> }
<section class="section">
    <p class="breadcrumb">
        <a asp-controller="Cuenta" asp-action="Index">Mi cuenta</a> /
        <a asp-controller="Direcciones" asp-action="Index">Mis direcciones</a> / Nueva
    </p>
    <div class="section-heading"><div><p class="eyebrow">MIS DIRECCIONES</p><h1>Nueva dirección.</h1></div></div>
    <form asp-action="Crear" method="post" style="max-width:520px;margin-top:1.5rem">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:#c00;margin-bottom:1rem"></div>
        <div class="form-grid">
            <div class="wide"><label asp-for="NombreCompleto">Nombre del destinatario</label><input asp-for="NombreCompleto" autocomplete="name" /><span asp-validation-for="NombreCompleto"></span></div>
            <div><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" inputmode="numeric" maxlength="9" /><span asp-validation-for="Telefono"></span></div>
            <div class="wide"><label asp-for="Direccion">Dirección</label><input asp-for="Direccion" autocomplete="street-address" /><span asp-validation-for="Direccion"></span></div>
            <div><label asp-for="Distrito">Distrito / ciudad</label><input asp-for="Distrito" /><span asp-validation-for="Distrito"></span></div>
            <div><label asp-for="Referencia">Referencia (opcional)</label><input asp-for="Referencia" /><span asp-validation-for="Referencia"></span></div>
        </div>
        <label class="checkbox" style="margin:1rem 0;display:flex;align-items:center;gap:.5rem">
            <input asp-for="EsPredeterminada" /> Usar como dirección predeterminada
        </label>
        <div style="display:flex;gap:1rem;align-items:center;margin-top:1.25rem">
            <button type="submit" class="button">Guardar dirección</button>
            <a asp-controller="Direcciones" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
