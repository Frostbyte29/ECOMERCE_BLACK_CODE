@model IReadOnlyList<FavoritoViewModel>
@{ViewData["Title"] = "Mis favoritos";}
@section Styles { <partial name="_EstilosCompras" /> }
<section class="section">
    <p class="eyebrow">MI CUENTA</p>
    <h1>Mis favoritos.</h1>
    @if (Model.Count == 0)
    {
        <div class="empty">
            <h2>Aún no tienes favoritos.</h2>
            <p>Presiona el corazón en cualquier producto para guardarlo aquí.</p>
            <a href="/Catalogo" class="button">Ver catálogo →</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var f in Model)
            {
                <article class="product-card">
                    <a class="product-image" asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@f.ProductoId">
                        <img src="@f.Imagen" alt="@f.Nombre" loading="lazy" />
                        <span class="product-arrow" aria-hidden="true">↗</span>
                    </a>
                    <div class="product-caption">
                        <div>
                            <p class="eyebrow">@f.Categoria</p>
                            <h3><a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@f.ProductoId">@f.Nombre</a></h3>
                        </div>
                        <p class="product-price">@TiendaMapper.Dinero(f.Precio)</p>
                    </div>
                    @if (!f.HayStock) { <small class="muted">Agotado temporalmente</small> }
                    <form asp-controller="Favoritos" asp-action="Toggle" method="post" style="margin-top:.5rem">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productoId" value="@f.ProductoId" />
                        <input type="hidden" name="returnUrl" value="/Favoritos" />
                        <button type="submit" class="btn-favorito btn-favorito--activo" aria-label="Quitar de favoritos" title="Quitar de favoritos">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z"/>
                            </svg>
                            Quitar
                        </button>
                    </form>
                </article>
            }
        </div>
    }
</section>
