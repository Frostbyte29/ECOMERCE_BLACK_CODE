@model BlackCode.Web.Controllers.ProductoDetalleViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject FavoriteService Favorites
@{
    ViewData["Title"] = Model.Product?.Name ?? "Producto";
    var userId = UserManager.GetUserId(User);
    var isFavorite = Model.Product is not null && userId is not null && (await Favorites.GetProductIdsAsync(userId)).Contains(Model.Product.Id);
}
@if (Model.Product is null)
{
    <section class="not-found"><h1>Producto no encontrado</h1><a class="button button-dark" asp-controller="Home" asp-action="Index">VOLVER A LA TIENDA</a></section>
}
else
{
    <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">Inicio</a> › <a asp-controller="Productos" asp-action="Index" asp-route-categoria="@Model.Product.Category">@Model.Product.Category</a> › @Model.Product.Name</div>
    <section class="detail-layout">
        <div class="gallery single-image">
            <button type="button" class="main-product-image" data-gallery-open data-gallery-src="@Model.Product.ImageUrl" data-gallery-alt="@Model.Product.Name" aria-label="Ampliar imagen de @Model.Product.Name"><img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" /><span>AMPLIAR IMAGEN ↗</span></button>
        </div>
        <div class="product-info">
            <p class="eyebrow">@Model.Product.Category.ToUpperInvariant()</p>
            <div class="detail-title"><h1>@Model.Product.Name</h1>@if (User.Identity?.IsAuthenticated != true)
                {
                    <button type="button" class="detail-heart" data-favorite-open data-product-image="@Model.Product.ImageUrl" aria-label="Guardar @Model.Product.Name en favoritos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.5c0 4.2-8.8 10.5-8.8 10.5S3.2 12.7 3.2 8.5a4.7 4.7 0 0 1 8.8 2.2 4.7 4.7 0 0 1 8.8 2.2Z"/></svg></button>
                }
                else
                {
                    <button type="button" class="detail-heart @(isFavorite ? "is-favorite" : "")" data-favorite-toggle data-product-id="@Model.Product.Id" aria-pressed="@(isFavorite ? "true" : "false")" aria-label="@(isFavorite ? "Quitar de favoritos" : "Guardar en favoritos")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.5c0 4.2-8.8 10.5-8.8 10.5S3.2 12.7 3.2 8.5a4.7 4.7 0 0 1 8.8 2.2 4.7 4.7 0 0 1 8.8 2.2Z"/></svg></button>
                }</div>
            <div class="product-meta"><span class="detail-price">S/ @Model.Product.Price.ToString("0.00")</span></div>
            <p class="description">@Model.Product.Description</p>
            <div class="specs"><div><span>MATERIAL</span><b>@Model.Product.Material</b></div><div><span>ACABADO</span><b>@Model.Product.Finish</b></div></div>
            <form class="buy-form" asp-controller="Carrito" asp-action="Agregar" method="post">
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <div class="size-heading"><span>TALLA</span></div>
                <div class="sizes">
                    @foreach (var size in Model.Product.Sizes)
                    {
                        <label class="size-option"><input type="radio" name="size" value="@size" checked="@(size == (Model.Product.Sizes.Contains("9") ? "9" : Model.Product.Sizes.First()))" /><span>@size</span></label>
                    }
                </div>
                <label class="quantity-label" for="quantity">CANTIDAD</label>
                <div class="buy-row"><div class="quantity-control"><button type="button" data-quantity-change="-1" aria-label="Disminuir cantidad">−</button><input id="quantity" name="quantity" type="number" min="1" max="@CartService.MaxQuantityPerLine" value="1" /><button type="button" data-quantity-change="1" aria-label="Aumentar cantidad">+</button></div></div>
                <button class="button button-dark full-width" type="submit">🛒 AGREGAR AL CARRITO</button>
                <button class="button button-outline full-width" type="submit" name="buyNow" value="true">COMPRAR AHORA</button>
            </form>
        </div>
    </section>
    <section class="section related-section"><div class="section-heading"><div><h2>También te puede interesar</h2></div><a class="text-link" asp-controller="Productos" asp-action="Index">VER TODOS →</a></div>
        <div class="product-grid">
            @foreach (var product in Model.RelatedProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
}
