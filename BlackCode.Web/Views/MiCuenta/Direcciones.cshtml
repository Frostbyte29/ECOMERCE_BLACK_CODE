@model List<SavedAddress>
@{
    ViewData["Title"] = "Mis direcciones";
}
<div class="account-shell">
    <partial name="_AccountNav" />
    <section class="account-main">
        <p class="eyebrow">DATOS DE ENVÍO</p>
        <div class="account-section-heading"><h1>Mis direcciones</h1><a class="button button-dark" asp-action="NuevaDireccion">+ AÑADIR DIRECCIÓN</a></div>
        <p class="account-intro">La dirección principal aparecerá primero al iniciar una compra. Podrás modificar los datos antes de confirmar el pedido.</p>
        @if (Model.Count == 0)
        {
            <div class="account-empty account-empty-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg><p>No tienes direcciones guardadas.</p></div>
        }
        else
        {
            <div class="address-grid">
                @foreach (var address in Model)
                {
                    <article class="address-card">
                        <div class="address-card-top"><h2>@address.Label</h2>@if (address.IsDefault) { <span>PRINCIPAL</span> }</div>
                        <strong>@address.RecipientName</strong>
                        <p>@address.Street<br />@address.District, @address.City<br />@address.Phone</p>
                        @if (!string.IsNullOrWhiteSpace(address.Reference)) { <small>Referencia: @address.Reference</small> }
                        <div class="address-actions">
                            <a asp-action="EditarDireccion" asp-route-id="@address.Id">Editar</a>
                            @if (!address.IsDefault)
                            {
                                <form asp-action="DireccionPrincipal" asp-route-id="@address.Id" method="post"><button type="submit">Hacer principal</button></form>
                            }
                            <form asp-action="EliminarDireccion" asp-route-id="@address.Id" method="post" onsubmit="return confirm('¿Eliminar esta dirección?')"><button type="submit">Eliminar</button></form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
