@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}
<div class="account-shell">
    <partial name="_AccountNav" />
    <section class="account-main">
        <p class="eyebrow">SEGURIDAD</p><h1>Cambiar contraseña</h1>
        <form asp-action="CambiarContrasena" method="post" class="form-card account-form">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>
            <div class="field"><label asp-for="CurrentPassword"></label><div class="password-field"><input asp-for="CurrentPassword" autocomplete="current-password" /><partial name="_PasswordEyeButton" model='"CurrentPassword"' /></div><span asp-validation-for="CurrentPassword"></span></div>
            <div class="field"><label asp-for="NewPassword"></label><div class="password-field"><input asp-for="NewPassword" autocomplete="new-password" /><partial name="_PasswordEyeButton" model='"NewPassword"' /></div><span asp-validation-for="NewPassword"></span></div>
            <div class="field"><label asp-for="ConfirmPassword"></label><div class="password-field"><input asp-for="ConfirmPassword" autocomplete="new-password" /><partial name="_PasswordEyeButton" model='"ConfirmPassword"' /></div><span asp-validation-for="ConfirmPassword"></span></div>
            <button class="button button-dark" type="submit">CAMBIAR CONTRASEÑA</button>
        </form>
    </section>
</div>
