@model CatalogoViewModel
@{ViewData["Title"]="Accesorios con identidad";}
@section Styles { <partial name="_EstilosCompras" /> }
<section class="hero">
<div class="hero-main hero-editorial"><div class="hero-art"><img src="/img/marca/editorial-anillo-pulsera.jpg" alt="Anillo y pulsera de acero combinados con ropa negra" width="657" height="535" fetchpriority="high" /></div><div class="hero-copy"><p class="eyebrow">BLACKCODE / COLECCIÓN 01</p><h1>MÁS QUE ACCESORIOS,<br>ES TU IDENTIDAD.</h1><p>Encuentra la pieza que define tu estilo.</p><a class="button light" href="/Catalogo">DESCUBRIR COLECCIÓN <span>↗</span></a></div><span class="hero-foot">DISEÑADO PARA SER TÚ — EST. 2026</span></div>
</section>
<div class="brand-strip">INDEPENDIENTE POR NATURALEZA <span>✳</span> ACERO QUE PERDURA <span>✳</span> ESTILO SIN REGLAS <span>✳</span></div>
<section class="section"><div class="section-heading"><div><p class="eyebrow">PIEZAS QUE DEJAN HUELLA</p><h2>Lo nuevo</h2></div><a class="underlined" href="/Catalogo">Ver todos los productos ↗</a></div><div class="product-grid home-grid">@foreach(var p in Model.Productos.Where(p=>p.Destacado).Take(4)){<partial name="_Producto" model="p"/>}</div></section>
<section class="section collections-section"><div class="section-heading"><h2>Explora las colecciones</h2></div><div class="collection-grid">
@foreach(var categoria in Model.Categorias) {
    var portada = Model.Productos.FirstOrDefault(p => p.Categoria == categoria.Nombre);
    if(portada is not null) {
        <a asp-controller="Catalogo" asp-action="Index" asp-route-Categoria="@categoria.Id"><img src="@portada.Imagen" alt="@categoria.Nombre" loading="lazy"/><h3>@categoria.Nombre.ToUpperInvariant() ↗</h3></a>
    }
}
</div></section>
<section id="nosotros" class="about about-editorial"><img class="about-photo" src="/img/marca/editorial-accesorios.jpg" alt="Detalle de anillo y pulsera en un conjunto negro" width="641" height="602" loading="lazy" /><div class="about-copy"><a class="logo brand brand-on-dark" href="/" aria-label="BlackCODE, inicio"><partial name="_Marca" /></a><p class="eyebrow">NUESTRA ESENCIA</p><h2>Menos ruido.<br>Más <em>identidad.</em></h2><p>BlackCODE nace de una idea: los detalles dicen quién eres. Creamos una selección de anillos, cadenas y pulseras para quienes eligen su propio camino.</p><p>Formas contundentes. Acero inoxidable. Piezas que se sienten tuyas desde el primer día.</p><a class="button light" href="/Catalogo">Encuentra tu pieza ↗</a></div></section>
