@model IReadOnlyList<BlackCode.Web.Models.Product>
@{
    ViewData["Title"] = "Inicio";
    var collections = Model.GroupBy(p => p.Category).Take(4).ToList();
}
<section class="hero">
    <img src="/images/products/portada-blackcode.jpg" alt="Joyería masculina en tonos oscuros" />
    <div class="hero-shade"></div>
    <div class="hero-copy">
        <p class="eyebrow">JOYERÍA PARA HOMBRES</p>
        <h1>Tu actitud,<br />tu código.</h1>
        <p class="hero-subtitle">DISEÑOS QUE HABLAN POR TI.</p>
        <a class="button button-light" asp-controller="Productos" asp-action="Colecciones">EXPLORAR COLECCIONES <span>→</span></a>
    </div>
</section>
<section class="section products-section" id="productos">
    <div class="section-heading"><div><h2>Lo nuevo</h2><p>Explora las piezas disponibles.</p></div><a class="text-link" asp-controller="Productos" asp-action="Index">VER TODOS →</a></div>
    <div class="product-grid">
        @foreach (var product in Model.Take(4))
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>
<section class="section home-collections" id="colecciones">
    <div class="section-heading"><div><h2>Colecciones</h2></div><a class="text-link" asp-controller="Productos" asp-action="Colecciones">VER TODAS →</a></div>
    <div class="home-collection-grid">
        @foreach (var collection in collections)
        {
            <a asp-controller="Productos" asp-action="Index" asp-route-categoria="@collection.Key" class="home-collection-card"><img src="@collection.First().ImageUrl" alt="" /><span>@collection.Key.ToUpperInvariant() →</span></a>
        }
    </div>
</section>
