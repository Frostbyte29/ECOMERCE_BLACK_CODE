@model CheckoutViewModel
@{
    ViewData["Title"] = "Datos de envío";
}
<section class="section checkout-page">
    <nav class="checkout-breadcrumb" aria-label="Ruta de compra"><a asp-controller="Carrito" asp-action="Index">Carrito</a><span aria-hidden="true">›</span><strong>Finalizar compra</strong><span aria-hidden="true">›</span><span>Confirmación</span></nav>
    <div class="checkout-page-heading"><p class="eyebrow">BLACK CODE / COMPRA</p><h1>Finalizar compra</h1><p>Revisa tu entrega y continúa al pago de demostración.</p></div>
    <partial name="_Steps" model="1" />
    <div class="checkout-layout">
        <form asp-action="Index" method="post" class="form-card checkout-shipping-form">
            <p class="checkout-form-intro">Selecciona dónde quieres recibir tu pedido. Podrás revisar el total antes de continuar.</p>
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>

            <div class="checkout-section-heading"><span>1</span><div><h3>Dirección de entrega</h3><p>Elige una dirección guardada o escribe otra para esta compra.</p></div></div>
            @if (Model.SavedAddresses.Count > 0)
            {
                <div class="shipping-choice-grid" role="radiogroup" aria-label="Dirección de entrega">
                    @foreach (var address in Model.SavedAddresses)
                    {
                        <label class="shipping-choice" data-shipping-address
                               data-shipping-name="@address.RecipientName" data-shipping-phone="@address.Phone"
                               data-shipping-street="@address.Street" data-shipping-district="@address.District"
                               data-shipping-city="@address.City" data-shipping-reference="@address.Reference">
                            <input type="radio" name="SelectedSavedAddressId" value="@address.Id" checked="@(Model.SelectedSavedAddressId == address.Id)" data-shipping-choice />
                            <span class="shipping-choice-body"><strong>@address.Label @if (address.IsDefault) { <em>PRINCIPAL</em> }</strong><span>@address.RecipientName</span><span>@address.Street<br />@address.District, @address.City</span><small>@address.Phone</small></span>
                        </label>
                    }
                    <label class="shipping-choice shipping-choice-new">
                        <input type="radio" name="SelectedSavedAddressId" value="" checked="@(Model.SelectedSavedAddressId is null)" data-shipping-choice />
                        <span class="shipping-choice-body"><strong>Otra dirección</strong><span>Escribir una para esta compra</span></span>
                    </label>
                </div>
            }
            else
            {
                <div class="checkout-no-address"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg><div><strong>Tu primera dirección</strong><p>Escribe dónde quieres recibir este pedido. Si deseas, puedes guardarla para la próxima compra.</p></div></div>
            }

            <div class="checkout-new-address" data-new-address-fields hidden="@(Model.SavedAddresses.Count > 0 && Model.SelectedSavedAddressId.HasValue)">
                <h3>Datos de esta entrega</h3>
                <div class="form-grid">
                    <div class="field field-wide"><label asp-for="ShippingName"></label><input asp-for="ShippingName" autocomplete="name" /><span asp-validation-for="ShippingName"></span></div>
                    <div class="field"><label asp-for="ShippingPhone"></label><input asp-for="ShippingPhone" type="tel" autocomplete="tel" placeholder="987654321" /><span asp-validation-for="ShippingPhone"></span></div>
                    <div class="field"><label asp-for="ShippingCity"></label><input asp-for="ShippingCity" autocomplete="address-level1" /><span asp-validation-for="ShippingCity"></span></div>
                    <div class="field field-wide"><label asp-for="ShippingAddress"></label><input asp-for="ShippingAddress" autocomplete="street-address" placeholder="Av. / Calle, número, dpto." /><span asp-validation-for="ShippingAddress"></span></div>
                    <div class="field"><label asp-for="ShippingDistrict"></label><input asp-for="ShippingDistrict" autocomplete="address-level2" /><span asp-validation-for="ShippingDistrict"></span></div>
                    <div class="field"><label asp-for="ShippingReference"></label><input asp-for="ShippingReference" placeholder="Opcional" /><span asp-validation-for="ShippingReference"></span></div>
                </div>
                <label class="account-check"><input asp-for="SaveNewAddress" data-save-address /> Guardar esta dirección en Mi cuenta para próximas compras</label>
                <div class="field checkout-address-label" data-save-address-label hidden="@(!Model.SaveNewAddress)"><label asp-for="NewAddressLabel">Nombre de la dirección</label><input asp-for="NewAddressLabel" placeholder="Por ejemplo: Casa o trabajo" maxlength="40" /><span asp-validation-for="NewAddressLabel"></span></div>
            </div>

            <div class="checkout-section-heading"><span>2</span><div><h3>Método de envío</h3><p>La tarifa ya está calculada para este pedido.</p></div></div>
            <div class="checkout-delivery-row"><span class="checkout-delivery-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8zM5 18a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm11 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z"/></svg></span><div><strong>Envío estándar</strong><small>Disponible para tu compra</small></div><b>@(Model.Cart.ShippingCost == 0 ? "Gratis" : "S/ " + Model.Cart.ShippingCost.ToString("0.00"))</b></div>
            <div class="checkout-section-heading checkout-notes-heading"><span>3</span><div><h3>Indicaciones para el pedido</h3><p>Opcional. Ayúdanos a encontrar la dirección o recibir tu pedido.</p></div></div>
            <div class="field"><label asp-for="Notes"></label><textarea asp-for="Notes" rows="2" placeholder="Opcional"></textarea><span asp-validation-for="Notes"></span></div>
            <button type="submit" class="button button-dark full-width">CONTINUAR AL PAGO →</button>
            @if (Model.SavedAddresses.Count > 0) { <a class="checkout-manage-link" asp-controller="MiCuenta" asp-action="Direcciones">Administrar mis direcciones</a> }
        </form>
        <aside class="summary-box checkout-summary">
            <div class="checkout-summary-head"><h2>Resumen del pedido</h2><a asp-controller="Carrito" asp-action="Index">Editar carrito</a></div>
            @foreach (var line in Model.Cart.Lines)
            {
                <div class="summary-line">
                    <img src="@line.Product.ImageUrl" alt="@line.Product.Name" />
                    <div class="summary-line-info"><b>@line.Product.Name</b><small>@(line.Size is null ? "" : $"Talla {line.Size} · ")Cant. @line.Quantity</small></div>
                    <span>S/ @line.LineTotal.ToString("0.00")</span>
                </div>
            }
            <div class="summary-totals">
                <div><span>Subtotal</span><span>S/ @Model.Cart.Subtotal.ToString("0.00")</span></div>
                <div><span>Envío</span><span>@(Model.Cart.ShippingCost == 0 ? "Gratis" : "S/ " + Model.Cart.ShippingCost.ToString("0.00"))</span></div>
                <div class="summary-total"><span>Total</span><span>S/ @Model.Cart.Total.ToString("0.00")</span></div>
            </div>
            <p class="checkout-demo-disclaimer">Este sitio está en modo demostración. Ningún pago se cobra realmente.</p>
        </aside>
    </div>
</section>
