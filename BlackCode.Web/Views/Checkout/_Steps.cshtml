@model int
<ol class="checkout-steps" aria-label="Progreso de la compra">
    <li class="@(Model >= 1 ? "done" : "")" @(Model == 1 ? "aria-current=step" : "")><span>1</span> Envío</li>
    <li class="@(Model >= 2 ? "done" : "")" @(Model == 2 ? "aria-current=step" : "")><span>2</span> Pago</li>
    <li class="@(Model >= 3 ? "done" : "")" @(Model == 3 ? "aria-current=step" : "")><span>3</span> Confirmación</li>
</ol>
