@model ProductoEdicionViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Crear producto" : "Editar producto"; }
@section Styles { <partial name="_EstilosCompras" /> }
@section Scripts { <script src="~/js/producto-imagen.js" asp-append-version="true" defer></script> }
<section class="section narrow">
<p class="breadcrumb"><a href="/Admin">Administración</a> / Producto</p>
<h1>@ViewData["Title"]</h1>
<form method="post" enctype="multipart/form-data">
<div asp-validation-summary="All"></div><input asp-for="Id" type="hidden" />
<div class="form-grid">
<div><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" /></div>
<div><label asp-for="Slug">Identificador URL</label><input asp-for="Slug" placeholder="anillo-nuevo" /></div>
<div class="wide"><label asp-for="Descripcion">Características y descripción</label><textarea asp-for="Descripcion" rows="4"></textarea></div>
<div><label asp-for="Precio">Precio (S/)</label><input asp-for="Precio" type="number" min="0.01" step="0.01" /></div>
<div><label asp-for="CategoriaId">Categoría</label><select asp-for="CategoriaId">@foreach(var o in Model.Categorias){<option value="@o.Id">@o.Nombre</option>}</select></div>
<div><label asp-for="ColorId">Color</label><select asp-for="ColorId">@foreach(var o in Model.Colores){<option value="@o.Id">@o.Nombre</option>}</select></div>
<div><label asp-for="MaterialId">Material</label><select asp-for="MaterialId">@foreach(var o in Model.Materiales){<option value="@o.Id">@o.Nombre</option>}</select></div>
<div class="wide image-editor" data-image-editor>
<label asp-for="ArchivoImagen">Imagen del producto</label><input asp-for="Imagen" type="hidden" />
<input asp-for="ArchivoImagen" type="file" accept=".jpg,.jpeg,.png,.webp" required="@(Model.Id == 0)" aria-describedby="imagen-ayuda imagen-error" />
<p id="imagen-ayuda" class="muted small">Elige una foto de tu equipo. JPG, PNG o WebP, máximo 5 MB. Se guardará al pulsar «Guardar producto».</p>
@if(!ViewData.ModelState.IsValid){<p class="small">Si habías elegido una foto, selecciónala nuevamente después de corregir los campos.</p>}
<p id="imagen-error" class="field-validation-error" aria-live="polite"></p><span asp-validation-for="ArchivoImagen"></span>
<figure class="image-preview"><img src="@Model.Imagen" data-current-image="@Model.Imagen" alt="Vista previa del producto" /><figcaption data-image-caption>@(Model.Id == 0 ? "Selecciona la fotografía del nuevo producto." : "Imagen actual. Puedes conservarla o elegir otra.")</figcaption></figure>
<button type="button" class="underlined" data-image-reset hidden>@(Model.Id == 0 ? "Quitar selección" : "Conservar imagen actual")</button>
</div>
<label class="checkbox"><input asp-for="Publicado" /> Publicado</label><label class="checkbox"><input asp-for="Destacado" /> Destacado</label>
</div>
<h2>Tallas y existencias</h2>
@for(var i=0;i<Model.Variantes.Count;i++){
<div class="variant-row"><input asp-for="Variantes[i].Id" type="hidden" />
<div><label asp-for="Variantes[i].Talla">Talla</label><input asp-for="Variantes[i].Talla" /></div>
<div><label asp-for="Variantes[i].Stock">Stock</label><input asp-for="Variantes[i].Stock" type="number" min="0" /></div>
<label class="checkbox"><input asp-for="Variantes[i].Activo" /> Activa</label></div>}
<p class="muted small">Los productos nuevos se crean con una variante. Las tallas existentes pueden editarse sin cambiar su historial.</p>
<div class="actions"><button class="button">Guardar producto →</button><a href="/Admin">Cancelar</a></div>
</form></section>
