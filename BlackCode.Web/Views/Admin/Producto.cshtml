@model ProductoEdicionViewModel
@{ViewData["Title"]=Model.Id==0?"Crear producto":"Editar producto";}
<section class="section narrow"><p class="breadcrumb"><a href="/Admin">Administración</a> / Producto</p><h1>@ViewData["Title"]</h1><form method="post"><div asp-validation-summary="All"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div><label asp-for="Nombre">Nombre</label><input asp-for="Nombre"/></div><div><label asp-for="Slug">Identificador URL</label><input asp-for="Slug" placeholder="anillo-nuevo"/></div><div class="wide"><label asp-for="Descripcion">Descripción</label><textarea asp-for="Descripcion" rows="4"></textarea></div><div><label asp-for="Precio">Precio (S/)</label><input asp-for="Precio" type="number" min="0.01" step="0.01"/></div><div><label asp-for="CategoriaId">Categoría</label><select asp-for="CategoriaId">@foreach(var o in Model.Categorias){<option value="@o.Id">@o.Nombre</option>}</select></div><div><label asp-for="ColorId">Color</label><select asp-for="ColorId">@foreach(var o in Model.Colores){<option value="@o.Id">@o.Nombre</option>}</select></div><div><label asp-for="MaterialId">Material</label><select asp-for="MaterialId">@foreach(var o in Model.Materiales){<option value="@o.Id">@o.Nombre</option>}</select></div><div class="wide"><label asp-for="Imagen">Imagen de colección</label><select asp-for="Imagen">@foreach(var nombre in new[]{"anillo-profano","anillo-aureo","anillo-bruma","anillo-tizzo","anillo-vertice","anillo-eslabon","cadena-eslabones","pulsera-eslabones"}){<option value="/img/productos/@(nombre).svg">@nombre</option>}</select></div><label class="checkbox"><input asp-for="Publicado"/> Publicado</label><label class="checkbox"><input asp-for="Destacado"/> Destacado</label></div><h2>Tallas y existencias</h2>@for(var i=0;i<Model.Variantes.Count;i++){<div class="variant-row"><input asp-for="Variantes[i].Id" type="hidden"/><div><label asp-for="Variantes[i].Talla">Talla</label><input asp-for="Variantes[i].Talla"/></div><div><label asp-for="Variantes[i].Stock">Stock</label><input asp-for="Variantes[i].Stock" type="number" min="0"/></div><label class="checkbox"><input asp-for="Variantes[i].Activo"/> Activa</label></div>}<p class="muted small">Los productos nuevos se crean con una variante. Las tallas existentes pueden editarse sin cambiar su historial.</p><div class="actions"><button class="button">Guardar producto →</button><a href="/Admin">Cancelar</a></div></form></section>
