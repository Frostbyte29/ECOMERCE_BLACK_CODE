@model IReadOnlyList<PedidoViewModel>
@{ViewData["Title"]="Gestión de pedidos";}
<section class="section"><p class="eyebrow">BLACKCODE / ADMINISTRACIÓN</p><h1>Gestionar pedidos.</h1><nav class="admin-tabs"><a href="/Admin">Productos e inventario</a><a class="active" href="/Admin/Pedidos">Pedidos</a></nav>@if(Model.Count==0){<div class="empty"><h2>Aún no hay pedidos.</h2><p>Las compras confirmadas aparecerán aquí.</p></div>}else{<div class="table-scroll"><table><thead><tr><th>Pedido</th><th>Cliente</th><th>Total</th><th>Estado actual</th><th>Actualizar</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><a class="underlined" href="/Pedidos/Detalle/@p.Id">@p.Codigo</a></td><td>@p.Cliente</td><td>@Dinero(p.Total)</td><td><span class="badge">@Estado(p.Estado)</span></td><td>@if(p.Siguientes.Count>0){<form asp-action="Estado" method="post" class="actions"><input type="hidden" name="id" value="@p.Id"/><select name="estado" aria-label="Nuevo estado de @p.Codigo">@foreach(var e in p.Siguientes){<option value="@e">@Estado(e)</option>}</select><button class="button small-button">Guardar</button></form>}else{<span class="muted">Finalizado</span>}</td></tr>}</tbody></table></div>}<p class="muted small">Cancelar un pedido repone su stock una sola vez. Los estados permitidos dependen del estado actual.</p></section>
