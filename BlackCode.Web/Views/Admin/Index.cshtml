@model AdminViewModel
@{ViewData["Title"]="Administración";}
<section class="section"><p class="eyebrow">BLACKCODE / ADMINISTRACIÓN</p><div class="section-heading"><h1>Panel general</h1><a class="button" href="/Admin/Producto">Crear producto +</a></div><nav class="admin-tabs"><a class="active" href="/Admin">Productos e inventario</a><a href="/Admin/Pedidos">Gestionar pedidos →</a></nav><div class="actions report-actions" id="reportes"><a class="underlined" href="/Admin/Reporte?formato=csv">Exportar inventario CSV ↓</a><a class="underlined" href="/Admin/Reporte?formato=json">Exportar inventario JSON ↓</a></div><div class="stats"><div><span>Productos</span><strong>@Model.Productos</strong></div><div><span>Pedidos</span><strong>@Model.Pedidos</strong></div><div><span>Ventas no canceladas</span><strong>@Dinero(Model.Ventas)</strong></div><div><span>Clientes / carritos invitados</span><strong>@Model.Clientes / @Model.CarritosInvitados</strong></div></div><div class="table-scroll" id="inventario"><table><thead><tr><th>Producto</th><th>Precio</th><th>Stock total</th><th>Visibilidad</th><th>Acciones</th></tr></thead><tbody>@foreach(var p in Model.Lista){<tr><td><div class="table-product"><img src="@p.Imagen" alt=""/><span>@p.Nombre</span></div></td><td>@Dinero(p.Precio)</td><td>@p.Variantes.Sum(v=>v.Stock)</td><td><span class="badge">@(p.Publicado?"Publicado":"Borrador")</span></td><td><div class="actions"><a href="/Admin/Producto/@p.Id">Editar ↗</a><form asp-action="Eliminar" method="post" data-confirm="¿Retirar este producto? Si tiene pedidos, se conservará como borrador."><input type="hidden" name="id" value="@p.Id"/><button class="remove-button">Retirar</button></form></div></td></tr>}</tbody></table></div></section>
